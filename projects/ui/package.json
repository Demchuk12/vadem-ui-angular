{
  "name": "@vadem/ui",
  "version": "0.2.0",
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": {
      "style": "./styles/index.css",
      "default": "./styles/index.css"
    },
    "./styles/*": {
      "default": "./styles/*"
    },
    "./fonts/*": {
      "default": "./fonts/*"
    }
  },
  "description": "Modern Angular UI components with dark and light themes, CSS design tokens, keyboard interactions, and English/Ukrainian localization.",
  "keywords": [
    "angular",
    "ui",
    "components",
    "design-system",
    "signals",
    "theming",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demchuk12/vadem-ui-angular.git",
    "directory": "projects/ui"
  },
  "homepage": "https://demchuk12.github.io/vadem-ui-angular/",
  "bugs": {
    "url": "https://github.com/Demchuk12/vadem-ui-angular/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
